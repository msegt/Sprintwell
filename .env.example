# Copy to .env (never commit .env). All settings are optional for local development.

# PostgreSQL connection string, or a SQLite file path. Default: ./data/sprintwell.db
# Hosted Postgres usually needs SSL: add ?sslmode=require
DATABASE_URL=./data/sprintwell.db

PORT=3000
# Public address of the app (used in exports).
PUBLIC_URL=http://localhost:3000
# Set to true behind a reverse proxy or a platform such as Render or Fly.io.
TRUST_PROXY=false
# Shown on the Support page, e.g. a GitHub Sponsors, Ko-fi or Open Collective link.
DONATION_URL=
# Link to the source code. The AGPL requires offering it to users of a modified version.
SOURCE_URL=
# Where the built web app lives (set automatically in Docker).
WEB_DIR=../web/dist
LOG_LEVEL=info
