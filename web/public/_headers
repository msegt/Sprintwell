# Security headers for the static web app when served by Cloudflare.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' ws: wss: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
